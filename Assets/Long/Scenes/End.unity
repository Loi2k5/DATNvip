--- !u!114 &133652324
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 133652323}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 52129cd8321230f4c8771f0dabb909ff, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  targetText: {fileID: 828040284}
  fullText: "Cu\u1ED1i c\xF9ng, sau h\xE0nh tr\xECnh d\xE0i \u0111\u1EA7y m\xE1u
    v\xE0 n\u01B0\u1EDBc m\u1EAFt, Shin \u0111\xE3 \u0111\u1EB7t ch\xE2n \u0111\u1EBFn
    trung t\xE2m c\u0103n c\u1EE9 c\u1EE7a b\u1ECDn qu\xE1i v\u1EADt.\r\n\r\nV\u1EDBi
    c\xFA b\u1EAFn cu\u1ED1i c\xF9ng, con tr\xF9m \u0111\u1EA7u s\u1ECF g\u1EE5c
    xu\u1ED1ng.\r\n\r\nNgay l\xFAc \u0111\xF3, c\xE1nh c\u1EEDa ph\xF2ng giam m\u1EDF
    ra. B\u1ED1 v\xE0 m\u1EB9 c\u1EADu nh\u1EEFng nh\xE0 khoa h\u1ECDc v\u0129 \u0111\u1EA1i
    lao \u0111\u1EBFn \xF4m c\u1EADu th\u1EADt ch\u1EB7t.\r\n\r\nKh\u1ED1i l\u1EADp
    ph\u01B0\u01A1ng ph\xE1t s\xE1ng r\u1EF1c r\u1EE1, l\u1EA7n \u0111\u1EA7u ti\xEAn
    h\xE9 l\u1ED9 b\xED m\u1EADt: n\xF3 ch\xEDnh l\xE0 ch\xECa kh\xF3a k\xEDch ho\u1EA1t
    b\u1EA3n thi\u1EBFt k\u1EBF v\u0169 kh\xED t\u1ED1i th\u01B0\u1EE3ng m\xE0 b\u1ED1
    m\u1EB9 c\u1EADu t\u1EEBng gi\u1EA5u k\xEDn.\r\n\r\nC\u1EADu \u0111\xE3 b\u1EA3o
    v\u1EC7 \u0111\u01B0\u1EE3c n\xF3, \u0111\xFAng nh\u01B0 l\u1EDDi d\u1EB7n n\u0103m
    x\u01B0a.\r\n\r\nD\u01B0\u1EDBi s\u1EF1 d\u1EABn d\u1EAFt c\u1EE7a Shin, con
    ng\u01B0\u1EDDi \u0111\xE3 ph\u1EE5c h\u1ED3i b\u1EA3n thi\u1EBFt k\u1EBF, t\xE1i
    x\xE2y d\u1EF1ng th\u1EBF gi\u1EDBi v\xE0 \u0111\xE1nh \u0111u\u1ED5i l\u0169
    qu\xE1i v\u1EADt c\xF2n s\xF3t l\u1EA1i.\r\n\r\nH\xF2a b\xECnh quay tr\u1EDF
    l\u1EA1i... nh\u01B0ng \u0111\xE2u \u0111\xF3 trong b\xF3ng t\u1ED1i, m\u1ED9t
    th\u1EBF l\u1EF1c kh\xE1c \u0111ang tr\u1ED7i d\u1EADy.\r\n"
  typingSpeed: 0.04
  storyImage: {fileID: 650891870}
